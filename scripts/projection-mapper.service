[Unit]
Description=Projection Mapper
After=multi-user.target sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
# Draw straight to the display via KMS/DRM -- no desktop session needed.
Environment="SDL_VIDEODRIVER=kmsdrm"
# The Pi 4 V3D driver exposes GL 3.1; moderngl wants 3.3. Our shaders only
# use features V3D actually supports, so advertising 3.3 is safe.
Environment="MESA_GL_VERSION_OVERRIDE=3.3"
Environment="MESA_GLSL_VERSION_OVERRIDE=330"
Environment="PYTHONUNBUFFERED=1"
# Frame pacing comes first when the Pi is busy (decoding casts, UPS polling).
Nice=-5
CPUWeight=200
ExecStart=@APP_DIR@/.venv/bin/python main.py --play
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
